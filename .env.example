# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this to .env and customize with your actual API keys

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=comma-delimited-list-of-allowed-user-ids

# =============================================================================
# HTTP API & DASHBOARD CONFIGURATION
# =============================================================================

# HTTP Server Settings (Local Development)
HTTP_HOST=localhost
HTTP_PORT=8080

# HTTP API Authentication
HTTP_API_KEY=local_dev_api_key_change_in_production

# Dashboard Authentication
HTTP_ADMIN_USERNAME=admin
HTTP_ADMIN_PASSWORD=admin123

# HTTP Templates Directory
HTTP_TEMPLATES_DIR=src/templates

# Note Templates Directory
NOTE_TEMPLATES_DIR=src/services/note/templates

# =============================================================================
# DATABASE CONFIGURATION (Local PostgreSQL via Docker or remote PostgreSQL)
# =============================================================================

DATABASE_URL=postgresql+asyncpg://second_brain_user:second_brain_password@localhost:5432/second_brain
DATABASE_ECHO=false
DATABASE_MAX_RETRY_COUNT=3

# =============================================================================
# VAULT & GIT CONFIGURATION
# =============================================================================

VAULT_PATH=./vault
VAULT_REPO_URL=your_vault_repo_url_here
GIT_REMOTE_NAME=
GIT_BRANCH_NAME=
GIT_COMMIT_MESSAGE_TEMPLATE=Add note: {title}

# =============================================================================
# SUMMARIZATION CONFIGURATION
# =============================================================================

SUMMARIZATION_LLM_PROVIDER=gemini
SUMMARIZATION_THRESHOLD=1000000
SUMMARIZATION_CHUNK_SIZE=4000
SUMMARIZATION_MODEL=gemini-3.5-flash
SUMMARIZATION_ADVANCED_MODEL=gemini-3.5-pro
SUMMARIZATION_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# TRANSCRIPTION CONFIGURATION
# =============================================================================

TRANSCRIBER_OPENAI_API_KEY=your_openai_api_key_here
TRANSCRIBER_SUPADATA_API_KEY=your_supadata_api_key_here

# =============================================================================
# STORAGE CONFIGURATION (Cloudflare R2)
# Leave R2_ACCOUNT_ID empty to use local disk storage instead
# =============================================================================

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=second-brain-uploads

# =============================================================================
# GOOGLE DRIVE EXPORT CONFIGURATION
# Used by src/export.py (hourly cron) to upload category aggregates to Drive
# Set GOOGLE_DRIVE_CREDENTIALS_JSON to the full service-account JSON (Railway)
# =============================================================================
# GOOGLE DRIVE EXPORT CONFIGURATION
# Used by src/export.py (hourly cron) to upload category aggregates to Drive.
#
# Step 1 (one-time local setup):
#   - In Google Cloud Console, create an OAuth 2.0 client (Desktop app type)
#   - Download the client secret JSON
#   - Run: GOOGLE_DRIVE_OAUTH_CLIENT_SECRET_FILE=/path/to/client_secret.json \
#           python3 src/auth_drive.py
#   - This opens a browser, you log in, and a token file is saved
#
# Step 2 - Local dev:
#   - Set GOOGLE_DRIVE_TOKEN_FILE to the saved token path
#
# Step 3 - Railway:
#   - Minify the token file: python3 -c "import json,sys; print(json.dumps(json.load(sys.stdin)))" < ~/.config/second-brain/drive_token.json
#   - Paste as GOOGLE_DRIVE_OAUTH_TOKEN_JSON
# =============================================================================

# For Railway (single-line JSON content of the saved token file)
GOOGLE_DRIVE_OAUTH_TOKEN_JSON=
# For local dev (path to the saved token file)
GOOGLE_DRIVE_TOKEN_FILE=~/.config/second-brain/drive_token.json
# Path to OAuth client secret JSON (only needed when running auth_drive.py)
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET_FILE=/path/to/client_secret.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# =============================================================================
# BATCH PROCESSING CONFIGURATION
# =============================================================================

BATCH_PROCESS_LIMIT=100

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

LOGS_PATH=./logs
